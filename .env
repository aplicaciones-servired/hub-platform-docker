# ⚠️  REQUERIDAS — Copiar a .env y CAMBIAR antes de desplegar
#
# Generar secrets:
#   openssl rand -base64 24   (POSTGRES_PASSWORD)
#   openssl rand -hex 32      (JWT_SECRET, JWT_REFRESH_SECRET)
#   openssl rand -hex 16      (SEED_ADMIN_PASSWORD)

POSTGRES_USER=hub_admin
POSTGRES_PASSWORD=123456789
DATABASE_URL=postgres://hub_admin:123456789@postgres:5432/hub_platform
JWT_SECRET=change_me_in_production_at_least_32_chars
JWT_REFRESH_SECRET=change_me_too_in_production_at_least_32
SEED_ADMIN_PASSWORD=13456789
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000,http://localhost:8081,https://soporte.serviredgane.cloud/
NEXT_PUBLIC_API_URL=http://localhost:3001/api
# URL del sistema externo (solo backend, nunca expuesta al frontend)
EXTERNAL_SYSTEMS_URL=http://localhost:8100/Seguridad-WEB/XHTML/general/login.xhtml
MAX_LOGIN_ATTEMPTS=5
