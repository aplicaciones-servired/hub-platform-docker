# ═══════════════════════════════════════════════════════════════
#  PRODUCTION — .env para el servidor Docker (VPS)
#  Copiar al servidor como `.env` y REEMPLAZAR todos los <GENERAR>
#  Generar secrets:
#    openssl rand -base64 24   (POSTGRES_PASSWORD)
#    openssl rand -hex 32      (JWT_SECRET, JWT_REFRESH_SECRET)
#    openssl rand -hex 16      (SEED_ADMIN_PASSWORD)
# ═══════════════════════════════════════════════════════════════

# ── PostgreSQL ────────────────────────────────────────────────
POSTGRES_USER=hub_admin
POSTGRES_PASSWORD=<GENERAR>
DATABASE_URL=postgres://hub_admin:<GENERAR>@postgres:5432/hub_platform

# ── JWT ───────────────────────────────────────────────────────
JWT_SECRET=<GENERAR>
JWT_REFRESH_SECRET=<GENERAR>

# ── Admin seed ────────────────────────────────────────────────
# Contraseña del admin inicial (documento 123456789).
# Se aplica SOLO si la base de datos aún no tiene admin.
SEED_ADMIN_PASSWORD=<GENERAR>

# ── Server ────────────────────────────────────────────────────
NODE_ENV=production
# API interna; Docker la expone solo en 127.0.0.1
# PORT=3001
# Dominios reales (los que apuntan DNS a este servidor)
CORS_ORIGIN=https://admin.tudominio.com,https://app.tudominio.com

# ── Sistema externo (opcional, solo backend) ──────────────────
# URL completa del login del sistema externo. Si el servidor está
# en una red distinta a la del sistema externo, usa la URL pública
# o elimina la línea (el módulo responderá 404).
EXTERNAL_SYSTEMS_URL=https://seguridad.tudominio.com/Seguridad-WEB/XHTML/general/login.xhtml

# ── Opcionales (tienen defaults) ──────────────────────────────
# MAX_LOGIN_ATTEMPTS=5
# JWT_EXPIRES_IN=24h
