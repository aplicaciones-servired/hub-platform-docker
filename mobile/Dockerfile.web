FROM node:22-alpine@sha256:16e22a550f3863206a3f701448c45f7912c6896a62de43add43bb9c86130c3e2 AS build

WORKDIR /app

COPY shared/package.json ./shared/
COPY mobile/package.json mobile/package-lock.json ./mobile/

WORKDIR /app/mobile
RUN npm ci --legacy-peer-deps

COPY shared/ ./shared/
COPY mobile/ ./

# .env queda excluido por el .dockerignore raíz (**/.env), la URL se inyecta por build arg
ARG EXPO_PUBLIC_API_URL=/api
ENV EXPO_PUBLIC_API_URL=${EXPO_PUBLIC_API_URL}
# Fail-fast: si la variable llega vacía, romper el build y no producir un bundle roto
RUN test -n "$EXPO_PUBLIC_API_URL"

RUN npx expo export --platform web

# Extraer <style> y <script> inline a archivos externos (CSP sin unsafe-inline)
COPY scripts/extract-inline.sh /tmp/extract-inline.sh
COPY mobile/assets/reset.css /tmp/extract-assets/reset.css
COPY mobile/assets/sw-register.js /tmp/extract-assets/sw-register.js
RUN chmod +x /tmp/extract-inline.sh && /tmp/extract-inline.sh /app/mobile/dist && rm -rf /tmp/extract-inline.sh /tmp/extract-assets

FROM nginx:alpine@sha256:54f2a904c251d5a34adf545a72d32515a15e08418dae0266e23be2e18c66fefa

COPY mobile/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/mobile/dist /usr/share/nginx/html
COPY mobile/assets/icon.png /usr/share/nginx/html/assets/icon.png
COPY mobile/assets/icon-512.png /usr/share/nginx/html/assets/icon-512.png

EXPOSE 8081

HEALTHCHECK --interval=30s --timeout=10s --start-period=10s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://localhost:8081 || exit 1

CMD ["nginx", "-g", "daemon off;"]
